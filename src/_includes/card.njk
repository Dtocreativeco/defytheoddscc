<a class="card" href="{{ post.url }}"><img src="{{ post.data.card_image or post.data.hero_image }}" alt="{{ post.data.title }}" loading="lazy"><div class="card__body"><span class="tag">{{ post.data.tag or "Marketing tips" }}</span><h3>{{ post.data.title }}</h3><p>{{ post.data.description }}</p><span class="more">Read article</span></div></a>